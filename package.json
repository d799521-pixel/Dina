{
  "name": "dina",
  "productName": "Dina",
  "version": "0.4.0",
  "description": "Cahier journal, préparations et tableau de classe — application de bureau 100 % hors-ligne pour professeurs des écoles.",
  "private": true,
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "dist": "npm run build && electron-builder",
    "dev:web": "vite -c vite.web.config.ts",
    "build:web": "vite build -c vite.web.config.ts"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/playwrite-fr-moderne": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "fr.dina.app",
    "productName": "Dina",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dina-Installation-${version}.${ext}",
      "shortcutName": "Dina"
    },
    "portable": {
      "artifactName": "Dina-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "artifactName": "Dina-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "artifactName": "Dina-${version}.${ext}"
    },
    "publish": null,
    "npmRebuild": false
  },
  "author": {
    "name": "Dina"
  }
}
